# Copy to .env (gitignored) and fill in. Never commit real credentials.
# Consumed by environment.bat / environment.sh and read by ca_agent.config.

# Vision API - any OpenAI-compatible endpoint (SPEC-01 requirement 3).
CAAGENT__VISION__BASE_URL=https://api.openai.com/v1
CAAGENT__VISION__MODEL=gpt-4o-mini
CAAGENT__VISION__API_KEY=

# Optional external tools. Leave blank to record affected files as NO_COMPATIBLE_READER.
CAAGENT__EXTERNAL_TOOLS__SOFFICE_PATH=
CAAGENT__EXTERNAL_TOOLS__UNRAR_PATH=
