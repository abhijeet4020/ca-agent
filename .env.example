# Copy to .env (gitignored) and fill in. Never commit real credentials.
# Consumed by environment.bat / environment.sh and read by ca_agent.config.
#
# Every variable is CAAGENT__<SECTION>__<KEY>, matching a field in config/settings.py.
# Anything set here overrides config/pipeline.toml.

# --- Vision API (SPEC-01 requirement 3) ------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. The vision route asks for structured
# output via response_format json_schema and validates the reply against it, so the model
# must be one that can both see images and return JSON.
CAAGENT__VISION__BASE_URL=http://localhost:1234/v1
CAAGENT__VISION__MODEL=google/gemma-3-4b
CAAGENT__VISION__API_KEY=test

# For a local server (LM Studio, Ollama, vLLM) leave API_KEY unset entirely - it is optional
# for localhost and no Authorization header is sent:
# CAAGENT__VISION__BASE_URL=http://localhost:1234/v1
# CAAGENT__VISION__MODEL=google/gemma-3-4b
#
# OpenAI's strict schema mode guarantees the reply matches the schema, but LM Studio rejects
# the flag with HTTP 400 "terminated". It is off by default and the reply is validated here
# either way; turn it on only for OpenAI.
# CAAGENT__VISION__STRICT_SCHEMA=true

# Set to false to make the pipeline refuse to spend anything, for a dry run.
CAAGENT__VISION__ENABLED=true

# Cost and reliability knobs. max_image_edge_pixels bounds both request size and per-image
# price; the backoff settings are excluded from the reuse fingerprint because they do not
# change what a successful extraction contains.
# CAAGENT__VISION__MAX_IMAGE_EDGE_PIXELS=2000
# CAAGENT__VISION__MAX_OUTPUT_TOKENS=4096
# CAAGENT__VISION__MAX_ATTEMPTS=5
# CAAGENT__VISION__REQUEST_TIMEOUT_SECONDS=120
# CAAGENT__VISION__MAX_CONCURRENCY=4

# --- Locked client documents (ADR-016) -------------------------------------------------
# Optional. Path to a gitignored TOML file mapping category/client to a PAN and date of
# birth, used to open AIS and TIS filings. See config/credentials.example.toml.
CAAGENT__CREDENTIALS__CLIENT_CREDENTIALS_PATH=

# --- Optional external tools -----------------------------------------------------------
# Leave blank to record affected files as NO_COMPATIBLE_READER rather than failing.
CAAGENT__EXTERNAL_TOOLS__SOFFICE_PATH=
CAAGENT__EXTERNAL_TOOLS__UNRAR_PATH=
